# Copy this file to .env.local and fill in the values.

# Neon Postgres connection string.
# Neon dashboard -> your project -> Connect -> use the "Pooled connection" URL so
# Better Auth's serverless queries don't exhaust database connections.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth secret used to sign sessions/tokens. Use a long random string.
# Generate one with:  npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used by Better Auth for callbacks and cookies).
BETTER_AUTH_URL="http://localhost:3000"
